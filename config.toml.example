# oxcore server configuration
# Copy this file to config.toml and modify as needed:
#   cp config.toml.example config.toml
#
# Default URLs match docker-compose.yml (PostgreSQL on localhost:5432).
# Start PostgreSQL with: podman compose up -d postgres

# PostgreSQL database shared by all oxcore services.
[postgres]
database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"

[auth]
# Database connection URL
login_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"

# Network settings
realm_server_port = 3724
bind_ip = "0.0.0.0"

# Directories
patches_dir = "./patches"
logs_dir = ""  # Empty = current directory

# Timing settings
max_ping_time = 30
min_realm_list_delay = 1
realms_state_update_delay = 20
max_session_duration = 300

# Security settings
geo_locking = false
strict_version_check = true
req_email_verification = false

# Logging
# Log levels: 0=Error, 1=Warning, 2=Info, 3=Debug, 4=Trace
log_level = 3
log_file = "auth.log"
log_file_level = 0

[auth.wrong_pass]
max_count = 0
ban_time = 600
ban_type = 0

[bnet]
# Battle.net services for patched 1.14.x clients. Generate the TLS files with:
#   cargo run -p oxcore-bnet -- gen-certs --out ./certs --host localhost
login_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
bind_ip = "0.0.0.0"
bnet_port = 1119
login_port = 8081
external_hostname = "localhost"
cert_file = "./certs/bnet.cert.pem"
key_file = "./certs/bnet.key.pem"
logs_dir = ""
log_level = 2
log_file = "bnet.log"
log_file_level = 0

[world]
# Realm ID — must match the `id` column in auth.realmlist for this world server
realm_id = 1
realm_name = "oxcore"

# Database connection URLs
world_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
character_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
login_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
logs_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"

# Network settings
world_server_port = 8085
bind_ip = "0.0.0.0"

# Directories
data_dir = "./data"
logs_dir = ""  # Empty = current directory

# World Update Settings
world_update_interval = 50  # milliseconds

# Visibility
# How far (yards) objects are shown to a player, per map kind. These are the
# 1.12 reference values. Cost scales with the square of the distance: raising
# the continent value multiplies both create/destroy packet volume and the
# number of creatures kept spawned. Set continents to 533 to restore the old
# "one full grid" behaviour.
visibility_distance_continents = 100
visibility_distance_instances = 170
visibility_distance_bg = 533
# Floor the continent distance will not shrink past when ticks run long.
# Continents shed load by shrinking visibility one yard per slow tick and
# growing it back when ticks are cheap.
visibility_distance_min = 45

# Seconds a grid must sit idle (no players in or near it) before it unloads
# and despawns its creatures.
grid_unload_delay_secs = 300

# Yards within which group members earn kill XP and may roll on loot
# (MaxGroupXPDistance in the reference server).
group_xp_distance = 74

# Logging
# Log levels: 0=Error, 1=Warning, 2=Info, 3=Debug, 4=Trace
log_level = 2
log_file = "world.log"
log_file_level = 2

# Performance
max_players = 100
player_limit = 0

# Weather
activate_weather = true          # Enable the zone weather system
change_weather_interval = 600000 # milliseconds between weather rolls (10 minutes)

[web]
# Browser-facing player portal and administration console. TLS should terminate at a reverse
# proxy in production; bind this service to a private interface in that deployment.
bind_ip = "0.0.0.0"
port = 8080
public_base_url = "http://127.0.0.1:8080"
auth_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
character_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
web_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
logs_database_url = "postgres://oxcore:oxcore@127.0.0.1:5432/oxcore"
